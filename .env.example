# Application
APP_NAME="Todo API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="todo_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Trusted proxies: IPs (or ranges) of the reverse proxies in front of the API, as a JSON list,
# e.g. ["10.0.0.5"] or ["10.0.0.0/8"].
# Only their X-Forwarded-For is read; empty = trust none.
TRUSTED_PROXIES=[]

# MCP server
MCP_SERVICE_KEY="generate me with openssl rand -hex 32"

# JWT
JWT_SECRET_KEY="change-me-with-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=5

# Refresh token
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_ABSOLUTE_MAX_DAYS=90

# Rate limit
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=30
SENSITIVE_RATE_LIMIT_MAX_ATTEMPTS=5
SENSITIVE_RATE_LIMIT_WINDOW_MINUTES=30
GENERAL_RATE_LIMIT_MAX_REQUESTS=100
GENERAL_RATE_LIMIT_WINDOW_MINUTES=1

# Idempotency key
IDEMPOTENCY_KEY_TTL_MINUTES=60
IDEMPOTENCY_LOCK_TTL_SECONDS=30

# Taskiq
TASK_RESULT_TTL_HOURS=2

# Prunable
SOFT_DELETE_RETENTION_DAYS=30
JOB_RETENTION_DAYS=30
API_TOKEN_EXPIRED_RETENTION_DAYS=30

# API token
API_TOKEN_MAX_ACTIVE=5

# Approvals requests
APPROVAL_REQUEST_EXPIRE_DAYS=7
APPROVAL_REQUEST_RETENTION_DAYS=90

# Audit logs
AUDIT_LOG_RETENTION_DAYS=365